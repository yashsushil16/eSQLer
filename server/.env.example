# eSQLer Server Environment Variables

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (App State)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/esqler?retryWrites=true&w=majority
MONGODB_URI=

# Authentication
# JWT_SECRET=generate_a_strong_random_string_here
JWT_SECRET=

# Database Connection Encryption Key (Must be 32 bytes/64 hex characters for AES-256-GCM)
# DB_ENCRYPTION_KEY=your_32_byte_hex_key_here
DB_ENCRYPTION_KEY=

# LLM Assistance (Optional)
# GROQ_API_KEY=gsk_...
GROQ_API_KEY=
# GEMINI_API_KEY=AIza...
GEMINI_API_KEY=
